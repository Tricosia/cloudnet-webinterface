## Customization
NEXT_PUBLIC_LOGO_PATH='/logos/logo.svg'
NEXT_PUBLIC_NAME=CloudNet

## Self-hosted domain name
NEXT_PUBLIC_DOMAIN=http://localhost:3000

## Cloudnet server address
NEXT_PUBLIC_CLOUDNET_ADDRESS=
## Hide the Cloudnet server address from input fields
NEXT_PUBLIC_CLOUDNET_ADDRESS_HIDDEN=false

CLOUDNET_REST_ENDPOINT=http://172.19.0.1:2812

CLOUDNET_ADMIN_USERNAME=
CLOUDNET_ADMIN_PASSWORD=

CLOUDNET_ACCESS_USERNAME=
CLOUDNET_ACCESS_PASSWORD=

KEYCLOAK_URL=
KEYCLOAK_REALM=
KEYCLOAK_CLIENT_ID=
KEYCLOAK_CLIENT_SECRET=

# Use Sentry
SENTRY_URL=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_SPOTLIGHT=false
